# Collection active par défaut (override possible via --collection)
COLLECTION_URL=https://www.instagram.com/<user>/saved/<collection>/<id>/
COLLECTION_SLUG=japon-2026

# Profil d'analyse : voyage | recettes | sport
COLLECTION_PROFILE=voyage

# Optionnel — l'analyse (phase interpret) passe par l'abonnement Claude Code,
# aucune clé API n'est nécessaire. Ces variables ne sont lues que si présentes.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
